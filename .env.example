# Copia este archivo a ".env.local" y completa tus propias credenciales de Supabase
# cuando quieras conectar el backend real. Mientras estas variables no existan,
# NexoCorp funciona igual usando el servicio de datos simulado (ver src/lib/data/).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: número de WhatsApp Business del negocio, usado como remitente por defecto
# en los enlaces "Enviar por WhatsApp" cuando el negocio no ha configurado el suyo.
NEXT_PUBLIC_DEFAULT_WHATSAPP_COUNTRY_CODE=57
